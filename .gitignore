# ====== DATOS Y VOLUMENES DOCKER ======
# NO subir nunca datos generados en runtime
data/
backup_origen/
postgres_data/
elastic_data/

# ====== CERTIFICADOS Y SECRETOS ======
certs/
*.pem
*.key
*.crt
*.p12
*.jks

# ====== LOGS ======
*.log
logs/

# La regla generica "*.txt" hizo perder backend/requirements.txt del control de
# versiones y dejo el repositorio sin poder construirse desde un clon limpio.
# Se acota a los volcados de texto de runtime y se declaran excepciones explicitas
# para todo el material que si tiene que estar publicado.
data/**/*.txt
logs/**/*.txt
!backend/requirements.txt
!**/requirements*.txt

# ====== MATERIAL DEL EXPERIMENTO (debe versionarse) ======
!experimento/**
!experimento/fixtures/**
!experimento/resultados/**

# ====== VARIABLES DE ENTORNO Y CREDENCIALES ======
.env
.env.local
.env.*.local
.env.production.local
.env.development.local

# ====== CONFIGURACIONES SENSIBLES (temporales) ======
# Descomenta si quitás las credenciales del docker-compose.yml
# docker-compose.override.yml

# ====== IDE Y EDITORES ======
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-settings

# ====== SISTEMAS OPERATIVOS ======
.DS_Store
.AppleDouble
.LSOverride
*.lnk
$RECYCLE.BIN/

# ====== NODE Y PYTHON (si aplica) ======
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ====== COMPILADOS Y BUILD ======
dist/
build/
*.o
*.so

# ====== MISC ======
*.bak
*.tmp
.cache/

# ====== HERRAMIENTAS DE IA ======
.gemini/
.opencode/
.windsurf/
.github/prompts/
.github/skills/
openspec/

# ====== MATERIAL DE TRABAJO (no forma parte del repositorio) ======
cambios_repositorio.md
